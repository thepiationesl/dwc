#!/usr/bin/env bash
# dwc-xstartup - VNC 桌面启动脚本（qwe 用户执行）
# 根据已安装的桌面环境选择启动器
set -eu

export DISPLAY=:1

# 等待 X 就绪
for _ in $(seq 1 20); do
    xdpyinfo >/dev/null 2>&1 && break
    sleep 0.3
done

# 启动中文输入法（若已装），需要 GTK/Qt 桌面环境
if command -v fcitx5 >/dev/null 2>&1; then
    nohup fcitx5 -d >/dev/null 2>&1 &
    export GTK_IM_MODULE=fcitx
    export QT_IM_MODULE=fcitx
    export XMODIFIERS=@im=fcitx
fi

# 桌面选择：icewm < xfce4 < startkde
if command -v icewm >/dev/null 2>&1; then
    exec icewm-session
elif command -v startxfce4 >/dev/null 2>&1; then
    exec startxfce4
elif command -v startkde >/dev/null 2>&1; then
    exec startkde
else
    exec xterm
fi
