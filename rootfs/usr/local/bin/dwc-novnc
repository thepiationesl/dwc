#!/usr/bin/env bash
# dwc-novnc - 启动 noVNC（浏览器访问 VNC）
# 依赖 dwc-xvnc 已启动（priority 更低，先启动）
set -eu

NOVNC_PORT="${NOVNC_PORT:-6080}"
VNC_PORT="${VNC_PORT:-5901}"

# 等待 VNC 端口就绪
for _ in $(seq 1 40); do
    (exec 3<>"/dev/tcp/127.0.0.1/${VNC_PORT}") 2>/dev/null && break
    sleep 0.5
done

# noVNC 的 websockify 入口
NOVNC_DIR="$(dirname "$(readlink -f "$(command -v novnc_proxy 2>/dev/null || command -v websockify 2>/dev/null || echo /usr/share/novnc/utils/novnc_proxy)")")"

if [ -f /usr/share/novnc/utils/novnc_proxy ]; then
    exec /usr/share/novnc/utils/novnc_proxy --listen "${NOVNC_PORT}" --vnc "127.0.0.1:${VNC_PORT}"
else
    exec websockify --web /usr/share/novnc "${NOVNC_PORT}" "127.0.0.1:${VNC_PORT}"
fi
